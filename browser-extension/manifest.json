{
    "manifest_version": 3,
    "name": "EdgeAI Policy",
    "version": "1.0.0",
    "description": "Real-time, on-device policy enforcement and PII redaction.",
    "icons": {
        "16": "public/icon128.png",
        "32": "public/icon128.png",
        "48": "public/icon128.png",
        "128": "public/icon128.png"
    },
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "notifications",
        "downloads"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "overlay.css"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "EdgeAI Policy Protection"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "injected-panel.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}