# ============================================================
# Privacy-Preserving Document Processing System
# Environment Configuration Template
# ============================================================
# SECURITY: Never commit real values. Use sealed secrets or
#           OS keyring for production keys.
# ============================================================

# --- Application ---
APP_NAME=SecureDocAI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./storage/secure_doc_ai.db

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_USE_SECURE_RANDOM_VALUE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Digital Signature ---
SIGNING_CERT_PATH=./storage/keys/certificate.pem
SIGNING_KEY_PATH=./storage/keys/private_key.pem
SIGNING_P12_PATH=./storage/keys/keystore.p12
SIGNING_P12_PASSPHRASE=CHANGE_ME

# --- Storage Paths ---
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
SIGNED_DIR=./storage/signed
KEYS_DIR=./storage/keys

# --- Detection Thresholds ---
DEFAULT_CONFIDENCE_THRESHOLD=0.85
DEFAULT_POLICY=default_policy

# --- Edge ML ---
ONNX_MODEL_PATH=./models/ner_model.onnx
USE_GPU=false
